{
  "manifest_version": 3,
  "name": "Torcons",
  "version": "1.0",
  "description": "AI Assistant to summarize pages and answer questions.",
  "icons": {
    "16": "assets/favicon-96x96.png",
    "48": "assets/web-app-manifest-192x192.png",
    "128": "assets/web-app-manifest-512x512.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/favicon-96x96.png",
      "48": "assets/web-app-manifest-192x192.png",
      "128": "assets/web-app-manifest-512x512.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["*://chat.torcons.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["floating_button.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://chat.torcons.ai/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.css", "popup.js", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
